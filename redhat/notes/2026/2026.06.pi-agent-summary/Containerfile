FROM registry.access.redhat.com/ubi9/python-312:latest

USER 0
WORKDIR /app

COPY pyproject.toml ./
COPY src/ ./src/
COPY container-entrypoint.sh /usr/local/bin/summary-agent-entrypoint

RUN python -m pip install --no-cache-dir . \
    && chmod 0555 /usr/local/bin/summary-agent-entrypoint \
    && chown -R 10001:0 /app

USER 10001

ENV PYTHONUNBUFFERED=1
ENTRYPOINT ["/usr/local/bin/summary-agent-entrypoint"]
CMD ["summary-benchmark", "--help"]
