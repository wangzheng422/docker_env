global
  log stdout format raw local0
  maxconn 20000

defaults
  log     global
  mode    http
  option  httplog
  option  dontlognull
  timeout connect 1000
  timeout client  50000
  timeout server  50000

frontend http_front
  bind *:8080
  stats uri /haproxy?stats
  default_backend http_back

backend http_back
  balance roundrobin
  # --- L7 Health Check ---
  option httpchk GET /healthz HTTP/1.0
  http-check expect status 200
  # Set default health check interval to 2 seconds (2000ms) for all servers
  default-server inter 2000
  # -----------------------
  # SERVERS_PLACEHOLDER
  #
  # --- 示例 1: 使用静态 IP 地址 ---
  # 如果您的后端服务器 IP 地址是固定的，可以像下面这样直接写入。
  # server server1 192.168.1.11:8080 check
  # server server2 192.168.1.12:8080 check
  #
  # --- 示例 2: 使用 DNS 名称 ---
  # 在 OpenShift/Kubernetes 等容器环境中，通常使用 Service 的 DNS 名称。
  # HAProxy 会解析这个 DNS 名称对应的所有 IP 地址 (Endpoints/Pods)。
  # 'check' 选项会启用对每个解析出 IP 的健康检查。
  # server my-app-service my-app-service.my-namespace.svc.cluster.local:8080 check
  #
  # --- 示例 3: 动态生成 (适用于模板) ---
  # 这是一个模板文件 (.template)，实际使用中，服务器列表通常由脚本或配置管理工具动态生成。
  # 例如，一个脚本可能会查找 OpenShift 中某个服务的所有 Pod IP，然后生成如下配置：
  server pod-1 10.128.0.15:8080 check
  server pod-2 10.129.1.22:8080 check
  # ... 更多 pod ...
