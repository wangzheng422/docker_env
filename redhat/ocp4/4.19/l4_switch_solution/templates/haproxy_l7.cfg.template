global
  log stdout format raw local0
  maxconn 20000

defaults
  log     global
  mode    http
  option  httplog
  option  dontlognull
  timeout connect 5000
  timeout client  50000
  timeout server  50000

frontend http_front
  bind *:8080
  stats uri /haproxy?stats
  default_backend http_back

backend http_back
  balance roundrobin
  # --- L7 Health Check ---
  option httpchk GET /healthz HTTP/1.0
  http-check expect status 200
  # -----------------------
  # SERVERS_PLACEHOLDER
