    <mxCell id="bp_r" value="Business Pods (Red)&#xa;*Matched by Controller*" style=" rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontStyle=1;" vertex="1" parent="ns_red">
      <mxGeometry x="40" y="40" width="240" height="60" as="geometry"/>
