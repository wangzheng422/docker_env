    <mxCell id="gp_b" value="Gateway Pod (Blue)&#xa;Dual Homed&#xa;eth0: OVN | macvlan0: Phys" style=" rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;" vertex="1" parent="ns_infra">
